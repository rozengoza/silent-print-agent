{
  "name": "silent-print-agent",
  "version": "1.0.0",
  "description": "A free, open source local print agent that enables silent, dialog-free printing from any web application via WebSocket.",
  "author": "rozengoza",
  "license": "MIT",
  "main": "src/main.js",
  "homepage": "https://github.com/rozengoza/silent-print-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozengoza/silent-print-agent.git"
  },
  "bugs": {
    "url": "https://github.com/rozengoza/silent-print-agent/issues"
  },
  "keywords": [
    "silent-print",
    "print-agent",
    "electron",
    "websocket",
    "no-print-dialog",
    "thermal-print",
    "pos",
    "invoice",
    "browser-print",
    "local-agent",
    "qz-tray-alternative",
    "silent-printing",
    "web-print"
  ],
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.rozengoza.silentprintagent",
    "productName": "Silent Print Agent",
    "copyright": "Copyright © 2026 rozengoza",
    "extraResources": [
      { "from": "src/assets/icon.png", "to": "icon.png" },
      { "from": "src/assets/icon.ico", "to": "icon.ico" },
      { "from": "src/config/origins.json", "to": "origins.json" }
    ],
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Silent Print Agent",
      "icon": "src/assets/icon.icns",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "shortcutName": "Silent Print Agent",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}